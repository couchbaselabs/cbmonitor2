    "@playwright/test": "^1.52.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.7",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
